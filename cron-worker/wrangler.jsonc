{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "govstatus-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Every-minute trigger for the probe cycle. The worker only wakes the
  // Next.js /api/probe endpoint; the probing itself stays in the app.
  "triggers": {
    "crons": ["*/1 * * * *"]
  },

  "vars": {
    "PROBE_URL": "https://govstatusnepal.techyatraa.com/api/probe"
  },

  "observability": {
    "enabled": true
  }
}