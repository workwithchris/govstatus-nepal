# Cloudflare D1 — status history storage.
# Token needs "D1: Edit" permission: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Shared secret for the /api/probe endpoint. Only needed when hosting the
# probe cycle on a Node platform (Vercel Cron, self-hosted) — the Cloudflare
# Worker is serve-only and /api/probe returns 403 there. Omit entirely if
# probing runs only from probe/nepal-probe.mjs.
CRON_SECRET=

# Optional: generic POST-JSON webhook for status-change alerts
# (Telegram bot, ntfy, Slack, …). Omit to disable alerting.
ALERT_WEBHOOK_URL=

# Optional: public per-service email notifications. DISABLED by default.
# To enable: set ENABLE_NOTIFICATIONS=true, add the email vars below, and
# render <SubscribeForm /> in the service dialog. probe/nepal-probe.mjs emails
# subscribers on status transitions via Cloudflare Email Sending REST.
# NOTIFY_FROM must be a domain onboarded to Email Sending.
# EMAIL_SENDING_ACCOUNT_ID=
# EMAIL_SENDING_API_TOKEN=
# NOTIFY_FROM=notify@yourdomain.com

# Optional: label for this probe machine in probe logs. Run the same script
# from multiple machines/ISPs for multi-vantage coverage (aggregation handles
# it); give each a distinct name.
# VANTAGE_NAME=ktm-home

# Optional: how often D1 history is persisted, in minutes (default 5, min 1).
# Lower = fresher history, higher = fewer D1 writes. Stays well inside the
# free-tier 100k writes/day limit at 5; use 10 if the account is shared.
# PERSIST_INTERVAL_MINUTES=10

# Optional: probe abort timeout in ms (default 45000, min 1000). Several .np
# municipal portals respond in 20-40s; the old 8000 default marked them "down".
# PROBE_TIMEOUT_MS=45000

# The Cloudflare Worker is serve-only by default (probing from a foreign
# datacenter marks healthy .np portals down). Set "true" to force serve-only
# on Node deployments too; leave unset to allow probing on Node runtimes.
# SERVE_ONLY=true

# probe/nepal-probe.mjs reads the same Cloudflare vars above plus:
# ALERT_WEBHOOK_URL (optional, same payload as the app).
